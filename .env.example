

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# Database
DB_PATH=./data/meetings.db

# Whisper (Speech-to-Text) Configuration
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Groq API (Required for Summary Generation)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Pinecone (Vector Database for RAG)
# Get your API key from: https://www.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=meeting-agent

# Email Configuration (For sending summaries)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=True

# Notion Integration (Optional)
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Audio Processing Configuration
SAMPLE_RATE=16000
AUDIO_CHANNELS=1
CHUNK_DURATION_MS=500
TRANSCRIPTION_WINDOW_SEC=30
SUMMARY_INTERVAL_MIN=10

# FFmpeg Path (Optional, auto-detected if not set)
# FFMPEG_PATH=/path/to/ffmpeg

# Application Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# CORS (comma-separated, '*' for all origins; set explicit origins in prod)
CORS_ORIGINS=*

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kontext_agent
CHROMA_DIR=./chroma_db
TRANSCRIPTS_DIR=data/meeting_transcripts

# LLM Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_INPUT_COST_PER_1K_TOKENS=0.0
GROQ_OUTPUT_COST_PER_1K_TOKENS=0.0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
# Alternative low-RAM option: gemma2:2b
OLLAMA_TIMEOUT=30.0
OLLAMA_KEEP_ALIVE=30m
OLLAMA_INPUT_COST_PER_1K_TOKENS=0.0
OLLAMA_OUTPUT_COST_PER_1K_TOKENS=0.0
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30.0
# Optional cap on LLM completion length (e.g. 2048). Leave empty for provider default.
LLM_MAX_TOKENS=

# Telemetry
OTEL_SERVICE_NAME=kontext-agent
OTEL_TRACES_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=

# Deepgram Configuration
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
DEEPGRAM_INTERIM_RESULTS=true
DEEPGRAM_PUNCTUATE=true
DEEPGRAM_DIARIZE=true
DEEPGRAM_SMART_FORMAT=true

# Embeddings (set to a multilingual model if you upload non-English docs)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Text Processing
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# WebSocket Configuration
WEBSOCKET_TIMEOUT=300.0

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Notion Integration
NOTION_TOKEN=your_notion_token_here
NOTION_PAGE_ID=your_notion_page_id_here

# Slack Integration
# Create a Slack App at https://api.slack.com/apps, add the chat:write scope,
# install it to your workspace, and copy the Bot User OAuth Token below.
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_DEFAULT_CHANNEL=#general

# Security
JWT_SECRET=replace_with_strong_random_secret_min_32_chars
JWT_EXPIRY_HOURS=24

# Rate Limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_PERIOD=60
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:5432/<database>
# Optional local dev override (sqlite) if DATABASE_URL is unset:
# CHAT_DB_PATH=./dev.db
